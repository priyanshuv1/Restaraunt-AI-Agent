APP_ENV=development
APP_NAME=DineMate AI

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/dinemate
REDIS_URL=redis://localhost:6379/0

# Qdrant vector store (use your Qdrant Cloud URL/key or local Qdrant service)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=dinemate_menu
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Comma-separated list of allowed frontend origins for CORS
ALLOWED_ORIGINS=http://localhost:3000

# LLM agent (Groq API key is required for /api/agent/chat)
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

LOG_LEVEL=INFO
